# Planetary runtime
PLANETARY_RUNTIME_ENABLED=true
PLANETARY_RUNTIME_STARTUP_WARM=true
PLANETARY_RUNTIME_INTERVAL_SECONDS=300
PLANETARY_RUNTIME_SOURCE_REFRESH_INTERVAL_SECONDS=900
PLANETARY_RUNTIME_BACKTEST_INTERVAL_SECONDS=21600

# Backend / auth
API_KEY=super_secure_api_key
ADMIN_KEY=super_secure_admin_key
JWT_SECRET=replace-with-real-jwt-secret
MONGO_URI=mongodb://localhost:27017/

# Behavior/public-signal providers
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Weather / disaster providers
OPENWEATHER_API_KEY=
NOAA_TOKEN=

# Internet telemetry providers
CLOUDFLARE_API_TOKEN=
FASTLY_API_TOKEN=
AKAMAI_CLIENT_TOKEN=
BGPSTREAM_TOKEN=

# Replay / smoke targeting
PLANETARY_FRONTEND_URL=http://127.0.0.1:5174
PLANETARY_BACKEND_URL=http://127.0.0.1:8002

# Hazard tuning knobs
PLANETARY_FLOOD_SIGNAL_RAIN_THRESHOLD=28
PLANETARY_FLOOD_SIGNAL_WIND_THRESHOLD=24
PLANETARY_CYCLONE_SIGNAL_WIND_THRESHOLD=38
PLANETARY_FLOOD_ACTIVE_THRESHOLD=0.5
PLANETARY_FLOOD_CRITICAL_THRESHOLD=0.68
PLANETARY_CYCLONE_ACTIVE_THRESHOLD=0.5
PLANETARY_CYCLONE_CRITICAL_THRESHOLD=0.68
